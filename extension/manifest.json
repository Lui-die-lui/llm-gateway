{
  "manifest_version": 3,
  "name": "LLM Gateway Guard",
  "version": "0.5.0",
  "description": "ChatGPT·Claude에 글을 보내기 전에 회사 게이트웨이로 민감정보를 가리고, 답변에서는 원래 값으로 되돌려 보여 줍니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LLM Gateway Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "lib.js",
        "ui.js",
        "mock/files.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
