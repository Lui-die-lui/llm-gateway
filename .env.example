# Copy to .env (never commit .env).  Run with: uvicorn app.main:app --env-file .env

# ---- external LLM ---------------------------------------------------------
# openai (default, any OpenAI-compatible endpoint) or anthropic (Claude)
UPSTREAM_PROVIDER=openai
UPSTREAM_API_KEY=
UPSTREAM_BASE_URL=https://api.openai.com/v1
# Force the model sent upstream (internal apps often send an OpenAI model name; e.g. claude-opus-5-5 for anthropic)
UPSTREAM_MODEL=
# "mock": answer locally without any API key (echoes the sanitized prompt back). Default for development and demos.
# Clear this line (and set UPSTREAM_API_KEY) to talk to a real LLM.
UPSTREAM_MODE=mock

# ---- internal model for `internal_only` data (OpenAI-compatible, e.g. Ollama) ----
INTERNAL_MODEL=
INTERNAL_BASE_URL=http://localhost:11434/v1
INTERNAL_API_KEY=

# ---- gateway ---------------------------------------------------------------
# on (default) / off: scan model answers for new PII and secrets
RESPONSE_SCAN=on
# If set, /v1/stats/*, /v1/audit/* and /v1/industries/reload need header X-Admin-Token
GATEWAY_ADMIN_TOKEN=
AUDIT_DB=data/audit.db
POLICY_DB=data/policy.db
EXCEPTIONS_DB=data/exceptions.db
SETTINGS_DB=data/settings.db
MEMBERS_DB=data/members.db
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Serve the built admin console (frontend/dist) from this server. The Docker image sets this; locally leave it unset (use npm run dev).
# CONSOLE_DIR=frontend/dist

# ---- Slack notice (optional) ----------------------------------------------
# A new exception request or sign-up request is posted to this Slack channel. An Incoming Webhook address is a secret:
# put it only in your own .env (never commit .env) or in the server's environment variables (Railway: Variables).
# It can also be saved from the console (Settings > Alerts); that value wins over this one.
SLACK_WEBHOOK_URL=
# The console's address, so the notice can link to the approval screen (e.g. https://your-app.up.railway.app)
GATEWAY_CONSOLE_URL=

