# Copy to .env (never commit .env)

# Which external LLM the gateway forwards to: openai (default) or anthropic
UPSTREAM_PROVIDER=openai
UPSTREAM_API_KEY=
# openai only: any OpenAI-compatible endpoint
UPSTREAM_BASE_URL=https://api.openai.com/v1
# Force the model sent upstream (internal apps often send an OpenAI model name; set e.g. claude-opus-5-5 for anthropic)
UPSTREAM_MODEL=
# Set to "mock" to run without any API key: upstream just echoes the sanitized prompt.
UPSTREAM_MODE=

GATEWAY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
